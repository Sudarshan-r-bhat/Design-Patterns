target/
build/
out/

### Maven ###
.mvn/
mvnw
mvnw.cmd
!/.mvn/wrapper/maven-wrapper.jar

### Java ###
*.class
*.jar
*.war
*.ear

### IDEs/Editors ###
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / STS
.project
.classpath
.settings/
.springBeans
.apt_generated
.factorypath
.sts4-cache

# NetBeans
/nbproject/
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

### OS files ###
.DS_Store
Thumbs.db

### Node / Python / misc ###
node_modules/
venv/
__pycache__/
*.py[cod]

### Temporary / backup / logs ###
*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig
*.rej
*.log

### Project-specific exceptions ###
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

### Misc help files kept out of repo ###
HELP.md

### NOTE ###
# If you need to re-add any entries from the removed file `design-patterns-.gitignore`,
# edit this file and run `git add .gitignore && git commit -m "Update .gitignore"`.
